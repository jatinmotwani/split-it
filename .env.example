# Copy to .env.local. In development only DATABASE_URL is required; everything else has a safe fallback.

# --- App ---
APP_URL=http://localhost:3000

# --- Database (Neon: pooled URL for the app, direct URL for migrations) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/splitit_dev
DATABASE_URL_UNPOOLED=

# --- Auth (Better Auth) ---
# Required in production: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth client (the Google button appears only when both are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (Resend). Without a key, codes are printed to the server console. ---
RESEND_API_KEY=
EMAIL_FROM=Split It <onboarding@resend.dev>

# --- Test-only: exposes /api/dev/outbox for e2e. Never set in production. ---
ENABLE_DEV_OUTBOX=

# --- Observability (both optional; without them nothing is sent) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
